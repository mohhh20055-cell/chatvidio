{
  "name": "education-platform",
  "version": "4.0.0",
  "description": "منصة تعليمية عالية الأداء مع أعلى معايير الأمان - نسخة محسنة مع JWT وCSRF وWebhook - تدعم Jitsi Meet للبث المباشر (مجاني 100%)",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.cjs",
    "dev": "tsx server.js",
    "prebuild": "node scripts/audit-pages.js && node scripts/test-ai-points.js && node scripts/test-db-writes.js && node scripts/test-fetch-wrapper.js",
    "build": "vite build && esbuild server.js --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "check:pages": "node scripts/audit-pages.js",
    "check:ai-points": "node scripts/test-ai-points.js",
    "check:db-writes": "node scripts/test-db-writes.js",
    "check:fetch": "node scripts/test-fetch-wrapper.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.64",
    "@google/genai": "^2.18.0",
    "@supabase/supabase-js": "^2.39.0",
    "ai": "^7.0.79",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.29.0",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "pusher": "^5.2.0",
    "path": "^0.12.7",
    "pngjs": "^7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^3.0.0",
    "sharp": "^0.35.5",
    "sofizpay-sdk-js": "^1.2.1",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.55.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "education",
    "platform",
    "learning",
    "secure",
    "jwt",
    "authentication",
    "csrf",
    "webhook",
    "supabase",
    "payment",
    "referral",
    "live-streaming",
    "jitsi",
    "jitsi-meet"
  ],
  "author": "ZoomDz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/education-platform.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/education-platform/issues"
  },
  "homepage": "https://github.com/yourusername/education-platform#readme"
}
