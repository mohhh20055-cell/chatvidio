# ============================================================
# إعدادات البيئة - ZoomDz Education Platform
# ============================================================

# ============ Supabase (مطلوب) ============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ============ Resend Email (مطلوب) ============
RESEND_API_KEY=re_your_resend_api_key

# ============ JWT Security (مهم للإنتاج) ============
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============ Encryption (مهم للإنتاج) ============
# يجب أن يكون 32 بايت في النظام السداسي عشري (64 حرف)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here
# يجب أن يكون 16 بايت في النظام السداسي عشري (32 حرف)
ENCRYPTION_IV=your-16-byte-hex-iv-here

# ============ reCAPTCHA (اختياري) ============
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ============ Chargily Payment (اختياري) ============
CHARGILY_API_KEY=your-chargily-api-key
CHARGILY_API_URL=https://pay.chargily.net/api/v2
CHARGILY_WEBHOOK_SECRET=your-webhook-secret

# ============ Platform Settings ============
PLATFORM_DOMAIN=https://chatvidio.vercel.app
PLATFORM_URL=https://chatvidio.vercel.app
API_BASE_URL=https://your-api-url.vercel.app

# ============ CORS ( للإنتاج) ============
CORS_ORIGIN=https://chatvidio.vercel.app,https://your-custom-domain.com

# ============ Admin Account ( للإنتاج) ============
ADMIN_EMAIL=admin@yourplatform.com
ADMIN_PASSWORD_HASH=your-hashed-admin-password

# ============ Server Settings ============
PORT=3000
NODE_ENV=development
