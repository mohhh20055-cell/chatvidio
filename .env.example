# ============================================================
# نموذج متغيرات البيئة - انسخ هذا الملف إلى .env واملأ القيم
# cp .env.example .env
# ============================================================

# --- Supabase (مطلوب) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# مفتاح الخدمة (اختياري - للعمليات الإدارية)
SUPABASE_SECRET_KEY=

# --- البريد الإلكتروني Resend (مطلوب لتشغيل الخادم) ---
# احصل على المفتاح من https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# --- الأمان ---
JWT_SECRET=change_this_to_a_long_random_secret
# مفاتيح التشفير (اختياري - يتم توليدها تلقائياً إن لم توجد)
# ENCRYPTION_KEY = 64 حرف hex (32 بايت)
# ENCRYPTION_IV  = 32 حرف hex (16 بايت)
ENCRYPTION_KEY=
ENCRYPTION_IV=

# --- reCAPTCHA (اختياري) ---
RECAPTCHA_SECRET_KEY=

# --- إعدادات الخادم ---
PORT=3000
NODE_ENV=development
# رابط المنصة (يُستخدم في الروابط والإشعارات)
PLATFORM_DOMAIN=http://localhost:3000
PLATFORM_URL=http://localhost:3000
# مصادر CORS المسموح بها مفصولة بفواصل (اتركه فارغاً للسماح افتراضياً)
CORS_ORIGIN=

# --- حساب المشرف (اختياري) ---
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- بوابة الدفع Chargily (اختياري) ---
CHARGILY_API_KEY=
CHARGILY_API_URL=
CHARGILY_WEBHOOK_SECRET=
