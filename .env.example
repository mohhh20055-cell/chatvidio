# ============================================================
# إعدادات البيئة - ZoomDz Education Platform
# ============================================================

# ============ Supabase (مطلوب) ============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ============ Resend Email (مطلوب) ============
RESEND_API_KEY=re_your_resend_api_key
# عنوان المُرسِل: استخدم بريد نطاقك المضاف في Resend (مثال: noreply@zoomdz.com)
# القيمة الافتراضية onboarding@resend.dev لا ترسل إلا إلى بريد حسابك فقط
RESEND_SENDER_EMAIL=onboarding@resend.dev
RESEND_SENDER_NAME=ZoomDz

# ============ JWT Security (مهم للإنتاج) ============
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============ Encryption (مهم للإنتاج) ============
# يجب أن يكون 32 بايت في النظام السداسي عشري (64 حرف)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here
# يجب أن يكون 16 بايت في النظام السداسي عشري (32 حرف)
ENCRYPTION_IV=your-16-byte-hex-iv-here

# ============ reCAPTCHA (مهم جداً) ============
# احصل على المفاتيح من: https://www.google.com/recaptcha/admin
# المفتاح العام - يمكن نشره على الواجهة الأمامية
RECAPTCHA_SITE_KEY=6Lcv8kctAAAAAHcoWBv_e87vrjP7I6IzQJSV6THf

# المفتاح السري - احفظه في متغيرات البيئة فقط على الخادم
# ⚠️ لا تنشر هذا المفتاح في GitHub أو في الكود الأمامي
RECAPTCHA_SECRET_KEY=your-secret-recaptcha-key-keep-it-secret

# ============ Chargily Payment (اختياري) ============
CHARGILY_API_KEY=your-chargily-api-key
CHARGILY_API_URL=https://pay.chargily.net/api/v2
CHARGILY_WEBHOOK_SECRET=your-webhook-secret

# ============ Platform Settings ============
# النطاق الرئيسي للمنصة
PLATFORM_DOMAIN=https://zoomdz.com
PLATFORM_URL=https://zoomdz.com
API_BASE_URL=https://zoomdz.com

# ============ CORS (للإنتاج) ============
# النطاقات المسموحة - افصل بين النطاقات بفواصل (،)
CORS_ORIGIN=https://zoomdz.com,https://www.zoomdz.com,http://localhost:3000

# ============ Admin Account ( للإنتاج) ============
ADMIN_EMAIL=admin@yourplatform.com
ADMIN_PASSWORD_HASH=your-hashed-admin-password

# ============ Server Settings ============
PORT=3000
NODE_ENV=development
